{
  "name": "invoex-functions",
  "description": "Firebase Cloud Functions for INVOEX v2.0",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": { "node": "20" },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "^1.29.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.3.2",
    "tesseract.js": "^7.0.0",
    "sharp": "^0.34.5",
    "pdf-lib": "^1.17.1",
    "mammoth": "^1.12.0",
    "file-type": "^16.5.4",
    "mime": "^4.1.0",
    "busboy": "^1.6.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "typescript": "~5.8.2",
    "@types/node": "^22.14.0",
    "@types/busboy": "^1.5.4"
  }
}
