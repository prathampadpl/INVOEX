rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Secure workspaces path by enforcing user isolation
    match /workspaces/{workspaceId}/users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) != null;
      allow write: if request.auth != null && request.auth.uid == userId && firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) != null;
    }
    
  }
}
