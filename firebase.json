{
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "INVOEX",
        "supportEmail": "prathamladpl@gmail.com"
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/extract", "function": "extract", "region": "us-central1" },
      { "source": "/api/auth/onboarding", "function": "onboarding", "region": "us-central1" },
      { "source": "/api/files/**", "function": "serveFile", "region": "us-central1" },
      { "source": "/api/webhooks/cashfree", "function": "cashfreeWebhookHandler", "region": "us-central1" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "invoex-backend",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "src",
        "*.ts",
        ".env*"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
