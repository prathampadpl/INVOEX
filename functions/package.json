    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@types/uuid": "^10.0.0",
    "axios": "^1.16.1",
    "file-type": "^16.5.4",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "mime": "^4.1.0",
    "openai": "^6.39.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2"
  }
}
