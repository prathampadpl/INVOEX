rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMember(workspaceId) {
      let workspace = get(/databases/$(database)/documents/workspaces/$(workspaceId));
      return (workspace != null && workspace.data.memberUids != null && request.auth.uid in workspace.data.memberUids) || exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }
    
    function isAdmin(workspaceId) {
      let memberDoc = get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
      return memberDoc != null && (memberDoc.data.role == 'admin' || memberDoc.data.role == 'owner');
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Workspaces collection
    match /workspaces/{workspaceId} {
      // Allow read/write if the user is a member
      allow read: if request.auth != null && isMember(workspaceId);
      allow write: if request.auth != null && isAdmin(workspaceId);
      
      // Allow creation if authenticated
      allow create: if request.auth != null;

      match /members/{memberId} {
        allow read: if request.auth != null && isMember(workspaceId);
        allow write: if request.auth != null && isAdmin(workspaceId);
      }

      match /invoices/{invoiceId} {
        allow read, write: if request.auth != null && isMember(workspaceId);
      }

      match /vendors/{vendorId} {
        allow read, write: if request.auth != null && isMember(workspaceId);
      }
      
      match /corrections_log/{logId} {
        allow read, write: if request.auth != null && isMember(workspaceId);
      }

      match /rules/{ruleId} {
        allow read: if request.auth != null && isMember(workspaceId);
        allow write: if request.auth != null && isAdmin(workspaceId);
      }
      
      match /settings/{settingId} {
        allow read: if request.auth != null && isMember(workspaceId);
        allow write: if request.auth != null && isAdmin(workspaceId);
      }

      match /export_history/{historyId} {
        allow read, write: if request.auth != null && isMember(workspaceId);
      }

      match /secrets/{secretId} {
        allow read, write: if request.auth != null && isAdmin(workspaceId);
      }
    }

    match /invites/{inviteId} {
      allow read: if request.auth != null && (isAdmin(resource.data.workspaceId) || request.auth.token.email == resource.data.email);
      allow create, update: if request.auth != null && isAdmin(request.resource.data.workspaceId);
      allow delete: if request.auth != null && (isAdmin(resource.data.workspaceId) || request.auth.uid == resource.data.invitedBy || request.auth.token.email == resource.data.email);
    }
  }
}
